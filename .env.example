VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Web Push public key (generate the pair with: npx web-push generate-vapid-keys)
# Put the PRIVATE key only in Supabase secrets (VAPID_PRIVATE_KEY), never in this file.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
